TA_BASE_URL=https://your-tubearchivist-instance.example
# Always needed server-side for the /thumb/ proxy (see proxy/README.md),
# regardless of ALLOW_INSECURE_TOKEN below.
TA_API_TOKEN=your-api-token-here
# Where THIS container ends up reachable — behind your own reverse proxy
# with a real domain/TLS is expected for actual use (GrayJay's Http
# package assumes https://); http://localhost:8080-style is fine for
# quick local testing only.
PLUGIN_BASE_URL=https://your-plugin-domain.example

# Optional, not recommended: also bakes TA_API_TOKEN into the publicly-
# fetchable config.json, instead of each device logging in for its own
# token. Anyone who can reach PLUGIN_BASE_URL could then read this token
# and use it against TA_BASE_URL directly. Leave commented out unless you
# specifically want this — see proxy/README.md ("Logging in vs. baking in
# a token").
# ALLOW_INSECURE_TOKEN=true
